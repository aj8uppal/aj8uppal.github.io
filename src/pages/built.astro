---
/**
 * /built — eleven more projects.
 *
 * A page rather than a section, because eleven more cards is most of a second
 * index and the index has a height budget that `npm run verify` enforces. The
 * main page keeps a door to here with the three that lead, and folds the rest.
 *
 * Three lead. Eyeshot, BeatLayer and Voidreach are the ones a person might
 * send to another person, and each gets a wide card with the frame beside the
 * copy, the way the flagship cards on the index are drawn. The other eight are
 * a grid of the same card at half width. That is the only ranking here.
 */
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { asset } from '../lib/images';
import { dots } from '../lib/text';
import { site } from '../data/content';
import { apps, built } from '../data/built';

/* A lead frame runs the wider half of a 1.15/1 split inside the shell: 660px
   at the maximum. A grid frame is a half card: 610px. Both are 88vw on a phone. */
const LEAD_W = [480, 660, 990, 1320];
const LEAD_S = '(min-width: 1400px) 660px, (min-width: 900px) 50vw, 90vw';
const SHOT_W = [420, 610, 900, 1220];
const SHOT_S = '(min-width: 1400px) 610px, (min-width: 900px) 46vw, 90vw';

const lead = apps.filter((a) => a.featured);
const rest = apps.filter((a) => !a.featured);
if (lead.length !== 3) throw new Error(`built: three lead the page, got ${lead.length}`);

const opens = apps.filter((a) => a.reach === 'open').length;
---

<Base
  title={`Eleven more · ${site.title}`}
  description="Eleven more projects — a daily eye test, a drum machine that plays under you, a space sandbox with other people in it, a shared sixty-second canvas, a graveyard for tabs. Nine open in a browser."
  elsewhere
>
  <section class="sec sec--ink bt-top">
    <div class="shell">
      <p class="eyebrow">aj8uppal.github.io &middot; built</p>

      <div class="bt-head">
        <h1 class="display bt-h1">{built.statement}</h1>
        <div class="bt-head__side">
          <p class="bt-lead">{built.lead}</p>
          <p class="bt-caveat">{built.caveat}</p>
        </div>
      </div>

      <dl class="bt-facts">
        {
          built.facts.map((f) => (
            <div>
              <dt>{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="sec sec--ink-deep bt-body">
    <div class="shell">
      <div class="bt-row">
        <p class="kicker">Three to send to someone</p>
        <p class="bt-row__p">
          A game you play in a minute a day, an instrument, and a place. Each one has a reason to
          open it again tomorrow.
        </p>
      </div>

      <div class="bt-leads">
        {
          lead.map((a, i) => (
            <article class="bcard bcard--lead" id={a.key} style={`--a:${a.accent}`}>
              <a class="bcard__shot" href={a.href} tabindex="-1" aria-hidden="true">
                <Picture
                  src={asset(`built-${a.key}`)}
                  alt=""
                  widths={LEAD_W}
                  sizes={LEAD_S}
                  formats={['avif']}
                  fallbackFormat="webp"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                />
              </a>

              <div class="bcard__body">
                <p class="bcard__meta">
                  <span class="bcard__kind">{a.kind}</span>
                  <span class:list={['bcard__state', `is-${a.reach}`]}>{a.reachLabel}</span>
                </p>

                <h2 class="display bcard__h bcard__h--lead">
                  <a href={a.href}>{a.name}</a>
                </h2>

                <p class="bcard__what bcard__what--lead">{a.what}</p>
                <p class="bcard__how">{a.how}</p>

                <p class="bcard__cap">{a.cap}</p>
                <p class="stack bcard__k">{dots(a.k)}</p>

                <p class="bcard__go">
                  <a href={a.href}>
                    {a.cta}
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                </p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="bt-row bt-row--rest">
        <p class="kicker">The other eight</p>
        <p class="bt-row__p">
          Tools, toys and one memo. Smaller, and each one does its one thing in the first minute.
        </p>
      </div>

      <div class="bt-grid">
        {
          rest.map((a) => (
            <article class="bcard" id={a.key} style={`--a:${a.accent}`}>
              <a class="bcard__shot" href={a.href} tabindex="-1" aria-hidden="true">
                <Picture
                  src={asset(`built-${a.key}`)}
                  alt=""
                  widths={SHOT_W}
                  sizes={SHOT_S}
                  formats={['avif']}
                  fallbackFormat="webp"
                  loading="lazy"
                  decoding="async"
                />
              </a>

              <div class="bcard__body">
                <p class="bcard__meta">
                  <span class="bcard__kind">{a.kind}</span>
                  <span class:list={['bcard__state', `is-${a.reach}`]}>{a.reachLabel}</span>
                </p>

                <h2 class="display bcard__h">
                  <a href={a.href}>{a.name}</a>
                </h2>

                <p class="bcard__what">{a.what}</p>
                <p class="bcard__how">{a.how}</p>

                <p class="bcard__cap">{a.cap}</p>
                <p class="stack bcard__k">{dots(a.k)}</p>

                <p class="bcard__go">
                  <a href={a.href}>
                    {a.cta}
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                </p>
              </div>
            </article>
          ))
        }
      </div>

      {
        /* The alt text is on the list below the cards rather than on each
          card's own image, which is decorative there: a reader who cannot see
          the picture has already been told what the app is twice. */
      }
      <ul class="sr" aria-label="What each capture shows">
        {
          apps.map((a) => (
            <li>
              {a.name}: {a.alt}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec sec--camel bt-foot">
    <div class="shell">
      <p class="kicker">Elsewhere</p>
      <h2 class="display bt-foot__h">There are seven bigger ones.</h2>
      <p class="bt-foot__p">
        The projects that took months &mdash; a multiplayer sailing game, a voxel tower defense, a
        rendering pipeline &mdash; are on the main page, along with everything else.
      </p>
      <p class="bt-foot__go">
        <a href="/">Back to the site <span aria-hidden="true">&rarr;</span></a>
        <a href="/#building">Straight to the projects <span aria-hidden="true">&rarr;</span></a>
      </p>
      <p class="bt-foot__n">
        {opens} of the eleven open in a browser with nothing to install and nobody to sign up as.
      </p>
    </div>
  </section>
</Base>

<style>
  /* ── Masthead ──────────────────────────────────────────────────────── */
  .bt-top {
    padding-block: clamp(4rem, 9vw, 7rem) clamp(2.4rem, 4vw, 3.4rem);
  }

  .bt-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.6rem, 4vw, 3.4rem);
    align-items: end;
    margin-top: 1.4rem;
  }

  .bt-h1 {
    max-width: 9ch;
    font-size: clamp(3rem, 8.4vw, 7.4rem);
  }

  .bt-head__side {
    display: grid;
    gap: 1rem;
  }

  .bt-lead {
    max-width: 56ch;
    margin: 0;
    font-size: clamp(1.02rem, 1.5vw, 1.2rem);
    line-height: 1.5;
  }

  /* The one asterisk on the whole page, said once. Set as an aside rather than
     as another paragraph, because it is about the page and not about the work. */
  .bt-caveat {
    max-width: 56ch;
    margin: 0;
    padding-left: 0.95rem;
    border-left: 2px solid var(--sand);
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .bt-facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem clamp(1.2rem, 3vw, 2.8rem);
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding-block: 1rem;
    border-block: 1px solid var(--line-dark);
  }

  .bt-facts div {
    display: grid;
    gap: 0.3rem;
  }

  .bt-facts dt {
    color: var(--muted);
    font: 680 0.66rem/1.4 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bt-facts dd {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(1.3rem, 2.4vw, 1.9rem);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 1;
    text-transform: uppercase;
  }

  /* ── The two rows ──────────────────────────────────────────────────── */
  .bt-body {
    padding-block: clamp(2.6rem, 5vw, 4rem) clamp(3.4rem, 7vw, 5.5rem);
  }

  .bt-row {
    display: grid;
    grid-template-columns: minmax(140px, 0.3fr) minmax(0, 1fr);
    gap: 0.4rem 2rem;
    align-items: start;
    margin: 0 0 clamp(1.3rem, 2.6vw, 2rem);
  }

  .bt-row--rest {
    margin-top: clamp(2.6rem, 5vw, 4rem);
  }

  .bt-row__p {
    max-width: 62ch;
    margin: 0;
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.5;
  }

  /* Three wide cards, stacked. The frame takes the wider column and the copy
     the narrower, and every second card swaps them so the eye zigzags down
     the three rather than reading one column twice. */
  .bt-leads {
    display: grid;
    gap: clamp(1.1rem, 2.2vw, 1.7rem);
  }

  /* Doubled up on purpose: .bcard below sets display: flex, at the same
     specificity and later in the sheet, and would win. */
  .bcard.bcard--lead {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  }

  .bcard--lead:nth-child(even) .bcard__shot {
    order: 2;
  }

  .bcard--lead .bcard__shot {
    border-bottom: 0;
    border-right: 2px solid var(--a);
  }

  .bcard--lead:nth-child(even) .bcard__shot {
    border-right: 0;
    border-left: 2px solid var(--a);
  }

  .bcard--lead .bcard__shot img {
    height: 100%;
    aspect-ratio: auto;
    object-position: left top;
  }

  .bcard__h--lead {
    font-size: clamp(2rem, 3.6vw, 2.9rem);
  }

  .bcard__what--lead {
    font-size: clamp(1.06rem, 1.5vw, 1.2rem);
  }

  /* ── The cards ─────────────────────────────────────────────────────── */
  .bt-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.1rem, 2.2vw, 1.7rem);
  }

  .bcard {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--line-dark-2);
    border-radius: var(--r-md);
    background: var(--ink-2);
    box-shadow: 0 10px 26px rgb(0 0 0 / 34%);
    transition:
      background var(--dur-2) var(--ease),
      border-color var(--dur-2) var(--ease);
  }

  .bcard:hover,
  .bcard:focus-within {
    border-color: color-mix(in srgb, var(--a) 60%, transparent);
    background: var(--ink-2-hi);
  }

  /* The capture sits on the screen colour, a step under the card, because it
     is a picture of a screen and should read as one. */
  .bcard__shot {
    display: block;
    position: relative;
    background: var(--screen);
    border-bottom: 2px solid var(--a);
  }

  .bcard__shot img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
  }

  .bcard__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(1rem, 1.9vw, 1.45rem);
  }

  .bcard__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem;
    margin: 0 0 0.7rem;
    font: 680 0.66rem/1.3 var(--mono);
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .bcard__kind {
    color: var(--a);
    font-weight: 800;
  }

  /* The one badge that carries information rather than decoration: whether you
     can press the link at the bottom and be using it. */
  .bcard__state {
    margin-left: auto;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--line-dark-2);
    border-radius: var(--r-xs);
    color: var(--on-ink-2);
  }

  .bcard__state.is-open {
    border-color: color-mix(in srgb, var(--a) 55%, transparent);
    color: var(--a);
  }

  .bcard__h {
    margin: 0 0 0.55rem;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  .bcard__h a {
    text-decoration: none;
  }

  /* The whole card is the target, and the heading link is what carries it, so
     a pointer anywhere on the card is over the link. The text of the link is
     still the only thing a screen reader is offered. */
  .bcard__h a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .bcard {
    position: relative;
  }

  .bcard__what {
    margin: 0 0 0.7rem;
    font-size: 1.02rem;
    line-height: 1.45;
  }

  .bcard__how {
    margin: 0 0 1rem;
    color: var(--on-ink-2);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .bcard__cap {
    margin: 0 0 0.35rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line-dark);
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .bcard__k {
    margin: 0 0 1rem;
    color: var(--muted);
    font: 640 0.68rem/1.4 var(--mono);
    letter-spacing: 0.05em;
  }

  .bcard__go {
    margin: auto 0 0;
  }

  .bcard__go a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--a);
    font-weight: 700;
    font-size: 0.94rem;
    text-decoration: none;
  }

  .bcard__go a span {
    transition: transform var(--dur-2) var(--ease);
  }

  .bcard:hover .bcard__go a span {
    transform: translateX(4px);
  }

  /* ── Foot ──────────────────────────────────────────────────────────── */
  .bt-foot {
    padding-block: clamp(3rem, 6vw, 4.6rem);
  }

  .bt-foot__h {
    max-width: 16ch;
    margin: 0.9rem 0 0;
    font-size: clamp(2rem, 4.4vw, 3.4rem);
  }

  .bt-foot__p {
    max-width: 56ch;
    margin: 1rem 0 0;
    font-size: 1.02rem;
  }

  .bt-foot__go {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.8rem;
    margin: 1.4rem 0 0;
    font-weight: 700;
  }

  .bt-foot__go a {
    display: inline-flex;
    gap: 0.4rem;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .bt-foot__n {
    margin: 1.6rem 0 0;
    color: var(--muted);
    font: 640 0.72rem/1.5 var(--mono);
    letter-spacing: 0.04em;
  }

  /* ── Narrow ────────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .bt-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .bt-head {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    .bt-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .bt-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .bcard.bcard--lead {
      grid-template-columns: minmax(0, 1fr);
    }

    .bcard--lead:nth-child(even) .bcard__shot {
      order: 0;
    }

    .bcard--lead .bcard__shot,
    .bcard--lead:nth-child(even) .bcard__shot {
      border-right: 0;
      border-left: 0;
      border-bottom: 2px solid var(--a);
    }

    .bcard--lead .bcard__shot img {
      height: auto;
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 620px) {
    .bt-h1 {
      max-width: none;
    }
  }
</style>
