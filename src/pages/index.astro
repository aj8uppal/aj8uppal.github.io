---
/**
 * Side A: the way round a hiring reader wants it. Who I am, what I am building
 * now, the log behind it, then the archive.
 *
 * The sections themselves live in src/sections so the two sides can run the
 * same six components in two orders. Nothing here but the running order.
 */
import Base from '../layouts/Base.astro';
import Hero from '../sections/Hero.astro';
import About from '../sections/About.astro';
import Projects from '../sections/Projects.astro';
import Experience from '../sections/Experience.astro';
import Playground from '../sections/Playground.astro';
import Skills from '../sections/Skills.astro';
import Contact from '../sections/Contact.astro';
---

<Base>
  <Hero />
  <About n="01" tone="paper" />
  <Projects n="02" tone="ink-deep" />
  <Experience n="03" tone="paper-2" order="newest" />
  <Playground n="04" tone="sand" />
  <Skills n="05" tone="ink-3" />
  <Contact n="06" tone="camel" />
</Base>
