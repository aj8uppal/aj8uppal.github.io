---
/**
 * Side A: the way round a hiring reader wants it. Who I am, what I am paid to
 * do, what I build outside it, then the archive.
 *
 * The sections themselves live in src/sections so the two sides can run the
 * same six components in two orders. Nothing here but the running order, and
 * the numbers come off the same list the nav is built from.
 */
import Base from '../layouts/Base.astro';
import Hero from '../sections/Hero.astro';
import About from '../sections/About.astro';
import Projects from '../sections/Projects.astro';
import Experience from '../sections/Experience.astro';
import Playground from '../sections/Playground.astro';
import Skills from '../sections/Skills.astro';
import Contact from '../sections/Contact.astro';
import { sideA as s } from '../lib/route';
---

<Base nav={s.nav}>
  <Hero />
  <About n={s.n('about')} tone="paper" />
  <Experience n={s.n('work')} tone="paper-2" order="newest" />
  <Projects n={s.n('building')} tone="ink-deep" />
  <Playground n={s.n('playground')} tone="sand" />
  <Skills n={s.n('skills')} tone="ink-3" />
  <Contact n={s.n('contact')} tone="camel" side="a" />
</Base>
