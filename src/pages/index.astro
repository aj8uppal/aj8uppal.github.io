---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Pill from '../components/Pill.astro';
import Section from '../components/Section.astro';
import Skim from '../components/Skim.astro';
import Arc from '../components/react/Arc';
import type { ArcShot } from '../components/react/Arc';
import AutoTyper from '../components/react/AutoTyper';
import DeviationFrame from '../components/react/DeviationFrame';
import FrameSwitcher from '../components/react/FrameSwitcher';
import type { SwitchFrame } from '../components/react/FrameSwitcher';
import GameFrame from '../components/react/GameFrame';
import StackFilter from '../components/react/StackFilter';
import { asset, sources } from '../lib/images';
import {
  about,
  contact,
  courses,
  cover,
  education,
  elderwood,
  earlier,
  ember,
  emberRegions,
  errata,
  evidence,
  hidamari,
  placeOrder,
  places,
  playground,
  roles,
  saltline,
  saltlineArc,
  skills,
} from '../data/content';
import type { PlaceKey } from '../data/content';

/* A full-bleed card lead runs the width of the shell: 1240 at the maximum. */
const LEAD_W = [720, 1080, 1440, 1920, 2480];
const LEAD_S = '(min-width: 1400px) 1240px, 94vw';

const HALF_W = [420, 640, 900, 1240];
const HALF_S = '(min-width: 1400px) 610px, (min-width: 900px) 46vw, 94vw';

/* The switcher and the arc share a stage: 1.35 of a 2fr split inside the card. */
const STAGE_W = [560, 860, 1200, 1720];
const STAGE_S = '(min-width: 1400px) 800px, (min-width: 1000px) 56vw, 88vw';

const THUMB_W = [96, 192];
const THUMB_S = '88px';

const INSET_W = [420, 640, 900, 1240];
const INSET_S = '(min-width: 1400px) 590px, (min-width: 1000px) 45vw, 88vw';

/* Elderwood's three captures sit in a half-width card. */
const EW_W = [280, 420, 560, 840];
const EW_S = '(min-width: 1400px) 570px, (min-width: 1000px) 44vw, 88vw';

const POSTER_W = [640, 960, 1280];
const POSTER_S = '(min-width: 1400px) 1200px, 92vw';

const emberAsset: Record<string, string> = {
  hearthvale: 'ember-region-hearthvale',
  fallowmere: 'ember-region-fallowmere',
  greenmarch: 'ember-region-greenmarch',
  fenmarch: 'ember-region-fenmarch',
  ashen: 'ember-region-ashen-waste',
  greywall: 'ember-region-greywall-peaks',
  plateau: 'ember-region-black-plateau',
};

const emberFrames: SwitchFrame[] = await Promise.all(
  emberRegions.map(async (f) => ({
    ...f,
    img: await sources(emberAsset[f.key] ?? '', STAGE_W, STAGE_S),
  })),
);

const arcFrames: ArcShot[] = await Promise.all(
  saltlineArc.map(async (f) => ({
    ...f,
    img: await sources(`saltline-arc-${f.key}`, STAGE_W, STAGE_S),
    thumb: await sources(`saltline-arc-${f.key}`, THUMB_W, THUMB_S),
  })),
);

const elderFrames: SwitchFrame[] = await Promise.all(
  elderwood.figures.map(async (f) => ({
    key: f.key,
    tab: f.tab,
    alt: `Elderwood Vale, ${f.cap.toLowerCase()}`,
    note: f.cap,
    img: await sources(`elderwood-${f.key}`, EW_W, EW_S),
  })),
);

const grinchPoster = await sources('legacy-grinchjump', POSTER_W, POSTER_S);

/* Tokens for the work-log filter. Anything a single job used is not a filter,
   it is a fact, and it stays in that job's stack line.

   Languages are the exception. "Where have you written TypeScript" is the
   question people actually arrive with, and answering it with one job is a
   better answer than not offering the question - so a language named in the
   skills section gets a chip on the strength of one job, and everything else
   still has to recur. */
const tokens = (stack?: string): string[] =>
  (stack ?? '')
    .split('·')
    .map((t) => t.replace(/\s*\(.*\)\s*$/, '').trim())
    .filter(Boolean);

const languages = new Set<string>(skills.find((g) => g.group === 'Languages')?.items ?? []);
const tally = new Map<string, number>();
for (const r of roles) for (const t of tokens(r.stack)) tally.set(t, (tally.get(t) ?? 0) + 1);
const filterTags = [...tally.entries()]
  .filter(([t, n]) => n > 1 || languages.has(t))
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([t]) => t);

const stackKey = (stack?: string): string =>
  `|${tokens(stack)
    .map((t) => t.toLowerCase())
    .join('|')}|`;

/* The current role is rendered on its own, with the room the other seven do
   not get. Both treatments keep the .role class and the stack key, so the
   filter still sees all eight. */
const current = roles.find((r) => r.now);
const past = roles.filter((r) => !r.now);

/* Glue each separator to the token before it with a non-breaking space, so a
   row that wraps can never open a line with a dangling middot. */
const dots = (...parts: Array<string | undefined>): string =>
  parts
    .flatMap((p) => (p ?? '').split('·'))
    .map((t) => t.trim())
    .filter(Boolean)
    .join('\u00a0· ');

/** Job title and stack on one line. */
const stackLine = (r: (typeof roles)[number]): string => dots(r.title, r.stack);

/* The skills index, resolved once. Every skill needs an entry in `evidence`,
   even an empty one, because a skill the page cannot back up and a skill
   somebody forgot to file look identical on the rendered page. This is the
   only place that can tell them apart, so it does. */
const skillIndex = skills.map((g) => ({
  group: g.group,
  items: g.items.map((name) => {
    const found = evidence[name as keyof typeof evidence] as readonly PlaceKey[] | undefined;
    if (!found) throw new Error(`skills: "${name}" has no entry in evidence`);
    return {
      name,
      id: `sk-${name
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '')}`,
      at: placeOrder.filter((k) => found.includes(k)).map((k) => places[k]),
    };
  }),
}));

const skillTotal = skillIndex.reduce((n, g) => n + g.items.length, 0);
const skillShown = skillIndex.reduce((n, g) => n + g.items.filter((i) => i.at.length).length, 0);

const heroLabel =
  'Soft patches of golden light drifting behind the name, as if through a canopy. Move the pointer or press the arrow keys and the light gathers where you point.';
---

<Base>
  {/* ── Hero ──────────────────────────────────────────────────────────── */}
  <header class="hero" id="top">
    <canvas id="hero-canvas" tabindex="0" role="img" aria-label={heroLabel}></canvas>

    <div class="shell hero__in">
      <p class="hero__meta">
        <span><i class="dot" aria-hidden="true"></i>{cover.kicker[1]}</span>
        <span>{cover.kicker[0]}</span>
      </p>

      <h1 class="display">
        <span>AJ</span><span class="out">Uppal</span>
      </h1>

      <div class="hero__bottom">
        <div class="hero__copy">
          <p class="hero__intro">{cover.lead}</p>
          <p class="hero__support">{cover.support}</p>
        </div>

        {
          /* Three actions at one weight is three actions with no answer to
            "where do I start". Now: the whole body of work, the one project
            that best represents it, and a way to write. Ember Wilds and the
            archive keep their own play links in their own sections. */
        }
        <div class="hero__actions">
          <div class="hero__btns">
            <a class="btn btn--sand" href="#building">Explore selected work</a>
            <a class="btn" href={saltline.href} target="_blank" rel="noopener">
              Play saltline<span class="arrow" aria-hidden="true">&#8599;</span>
            </a>
          </div>
          <a class="hero__mail" href={`mailto:${contact.email}`}>Email</a>
        </div>
      </div>
    </div>

    <p class="hint" aria-hidden="true">
      Bring your own light<span>Pointer, or the arrow keys</span>
    </p>
  </header>

  {/* ── 01 About ──────────────────────────────────────────────────────── */}
  <Section n="01" id="about" name="About" tone="paper">
    <div class="head" data-reveal>
      <div class="head__k">
        <p class="kicker">01 / About</p>
        <p class="head__count">Two degrees, one habit</p>
      </div>
      <div>
        <h2 class="display head__t">{about.statement}</h2>
      </div>
    </div>

    <dl class="vitals" data-reveal>
      {
        cover.strip.map((c) => (
          <div>
            <dt>{c.dt}</dt>
            <dd>
              {c.dd}
              <span>{c.sub}</span>
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="about">
      <div class="about__copy" data-reveal>
        {about.prose.map((p) => <p>{p}</p>)}
      </div>

      <dl class="facts" data-reveal>
        {
          about.notes.map(([k, v], i) => (
            <div class="fact">
              <span class="fact__i" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="method">
      <p class="kicker">Method</p>
      <p>{about.method}</p>
    </div>
  </Section>

  {/* ── 02 Projects ───────────────────────────────────────────────────── */}
  <Section n="02" id="building" name="Projects" tone="ink-deep" cls="work">
    <div class="head" data-reveal>
      <div class="head__k">
        <p class="kicker">02 / Projects</p>
        <p class="head__count">4 entries · 2 open to anyone</p>
      </div>
      <div>
        <h2 class="display head__t">Four projects</h2>
        <p class="head__lead head__lead--big">{cover.second}</p>
      </div>
    </div>

    <div class="grid">
      {/* saltline */}
      <article class="card card--full" id={places.saltline.at} data-place data-reveal>
        <div class="card__hero">
          <div class="card__plate">
            <div class="shot shot--lead">
              <Picture
                src={asset(saltline.lead.asset)}
                alt={saltline.lead.alt}
                widths={LEAD_W}
                sizes={LEAD_S}
                formats={['avif']}
                fallbackFormat="webp"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
              <p class="flag">{saltline.lead.flag}</p>
            </div>
            <p class="plate-cap"><b>{saltline.spread.t}.</b> {saltline.spread.s}</p>
          </div>

          <div class="card__intro">
            <span class="card__index">{saltline.spread.n}</span>
            <div class="card__badges">
              <Pill status={saltline.status} label="Live" />
              <span class="tag">01 &middot; Flagship</span>
              <span class="tag">Live multiplayer</span>
              <span class="tag">Six frames &middot; one seed</span>
            </div>

            <h3 class="display">
              <a href={saltline.href} target="_blank" rel="noopener">{saltline.name}</a>
            </h3>
            <p class="card__sub">{saltline.sub}</p>
            <Skim
              {...saltline.skim}
              cta={{ href: saltline.href, label: 'Play saltline', out: true }}
            />
          </div>
        </div>

        <div class="card__copy">
          <div class="card__cols">
            <div class="card__body">
              {saltline.prose.map((p) => <p>{p}</p>)}
            </div>
            <div class="card__aside">
              <details class="notes">
                <summary>Technical notes</summary>
                <dl class="specs">
                  {
                    saltline.plate.map(([k, v]) => (
                      <div>
                        <dt>{k}</dt>
                        <dd>{v}</dd>
                      </div>
                    ))
                  }
                  <div>
                    <dt>Open</dt>
                    <dd><a href={saltline.href} target="_blank" rel="noopener">saltline.app</a></dd>
                  </div>
                </dl>
              </details>
            </div>
          </div>

          <p class="card__lede">{saltline.framesLede}</p>
          <p class="cue">{saltline.framesCue}</p>
          <Arc client:visible frames={arcFrames} note={saltline.arcNote} />

          <div class="inset">
            <div class="shot shot--inset">
              <Picture
                src={asset('saltline-proof-panel')}
                alt="The same 16:46 frame uncropped, with the development panel down the left edge: time of day, sea state, wind angle, crest sharpness and seed. Three raider contacts are marked on the nav chart."
                widths={INSET_W}
                sizes={INSET_S}
                formats={['avif']}
                fallbackFormat="webp"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="inset__body">
              <h4>{saltline.proof.t}</h4>
              {saltline.proof.body.map((p) => <p>{p}</p>)}
            </div>
          </div>
        </div>
      </article>

      {/* Ember Wilds */}
      <article class="card card--full" id={places.ember.at} data-place data-reveal>
        <div class="card__hero">
          <div class="card__plate">
            <div class="shot shot--lead">
              <Picture
                src={asset('ember-spread-fallowmere-dusk')}
                alt="Fallowmere in Ember Wilds at dusk: an ember-orange plain of voxel trees, a level thirty character in the centre, quest log and satchel along the edges."
                widths={LEAD_W}
                sizes={LEAD_S}
                formats={['avif']}
                fallbackFormat="webp"
                loading="lazy"
                decoding="async"
              />
              <p class="flag">Fallowmere &middot; level 30 &middot; dusk</p>
            </div>
            <p class="plate-cap"><b>{ember.spread.t}.</b> {ember.spread.s}</p>
          </div>

          <div class="card__intro">
            <span class="card__index">{ember.spread.n}</span>
            <div class="card__badges">
              <Pill status={ember.status} label="Live MMORPG" />
              <span class="tag">02 &middot; In production</span>
              <span class="tag">64-player realm</span>
            </div>

            <h3 class="display">
              <a href={ember.href} target="_blank" rel="noopener">{ember.name}</a>
            </h3>
            <p class="card__sub">{ember.sub}</p>
            <Skim
              {...ember.skim}
              cta={{ href: ember.href, label: 'Open Ember Wilds', out: true }}
            />
          </div>
        </div>

        <div class="card__copy">
          <div class="card__cols">
            <div class="card__body">
              {ember.prose.map((p) => <p>{p}</p>)}
            </div>
            <div class="card__aside">
              <details class="notes">
                <summary>Technical notes</summary>
                <dl class="specs">
                  {
                    ember.plate.map(([k, v]) => (
                      <div>
                        <dt>{k}</dt>
                        <dd>{v}</dd>
                      </div>
                    ))
                  }
                  <div>
                    <dt>Open</dt>
                    <dd>
                      <a href={ember.href} target="_blank" rel="noopener">emberwilds-web.fly.dev</a>
                    </dd>
                  </div>
                </dl>
              </details>
            </div>
          </div>

          <p class="card__lede">{ember.framesLede}</p>
          <p class="cue">{ember.framesCue}</p>
          <FrameSwitcher client:visible label="Ember Wilds regions" frames={emberFrames} />

          <div class="inset">
            <div class="shot shot--inset">
              <Picture
                src={asset('ember-proof-two-players')}
                alt="Two Ember Wilds clients side by side in the Hearthvale. Each character has a speech bubble above it and the same two lines appear in the chat log at bottom left."
                widths={INSET_W}
                sizes={INSET_S}
                formats={['avif']}
                fallbackFormat="webp"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="inset__body">
              <h4>{ember.proof.t}</h4>
              {ember.proof.body.map((p) => <p>{p}</p>)}
            </div>
          </div>
        </div>
      </article>

      {/* hidamari */}
      <article class="card card--half" id={places.hidamari.at} data-place data-reveal>
        <div class="shot shot--lead">
          <Picture
            src={asset('hidamari-spread-canopy')}
            alt="hidamari: an autumn canopy path at golden hour, low sun through orange leaves, the trail running away between the trees."
            widths={HALF_W}
            sizes={HALF_S}
            formats={['avif']}
            fallbackFormat="webp"
            loading="lazy"
            decoding="async"
          />
          <p class="flag">Blender Cycles, offline &middot; 116 fps live</p>
        </div>

        <div class="card__copy">
          <span class="card__index">{hidamari.spread.n}</span>
          <div class="card__badges">
            <Pill status={hidamari.status} label="Not public" />
            <span class="tag">03 &middot; Rendering</span>
          </div>

          <h3 class="display">{hidamari.name}</h3>
          <p class="card__sub">{hidamari.sub}</p>

          <Skim {...hidamari.skim} />

          <div class="card__body">
            {hidamari.prose.map((p) => <p>{p}</p>)}
          </div>

          <details class="notes">
            <summary>Technical notes</summary>
            <dl class="specs">
              {
                hidamari.plate.map(([k, v]) => (
                  <div>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))
              }
            </dl>
          </details>
        </div>
      </article>

      {/* Elderwood Vale */}
      <article class="card card--half" id={places.elderwood.at} data-place data-reveal>
        <div class="card__copy">
          <span class="card__index">{elderwood.title}</span>
          <div class="card__badges">
            <Pill status={elderwood.status} label="Greybox" />
            <span class="tag">04 &middot; Architecture</span>
          </div>

          <h3 class="display">{elderwood.name}</h3>
          <p class="card__sub">{elderwood.sub}</p>

          <Skim {...elderwood.skim} />

          <div class="card__body">
            {elderwood.prose.map((p) => <p>{p}</p>)}
          </div>

          <details class="notes">
            <summary>Technical notes</summary>
            <dl class="specs">
              {
                elderwood.plate.map(([k, v]) => (
                  <div>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))
              }
            </dl>
          </details>

          <p class="card__lede">{elderwood.framesLede}</p>
          <p class="cue">{elderwood.framesCue}</p>
          <FrameSwitcher client:visible label="Elderwood Vale captures" frames={elderFrames} />
        </div>
      </article>
    </div>
  </Section>

  {/* ── 03 Experience ─────────────────────────────────────────────────── */}
  <Section n="03" id="work" name="Experience" tone="paper-2">
    <div class="log">
      <div class="log__intro">
        <p class="kicker">03 / Experience</p>
        <h2 class="display">Eight roles, one through-line</h2>
        <p>
          Physics research, university software, first-engineer jobs, and production healthcare AI.
          I keep turning up where the system is new and somebody has to make the first real version
          work.
        </p>
      </div>

      <div>
        <StackFilter client:visible tags={filterTags} total={roles.length} />

        <div class="roles">
          {
            current && (
              <article
                class="role role--now"
                id={places[current.key].at}
                data-place
                data-stack={stackKey(current.stack)}
              >
                {/* No dot after the date: the inked node on the spine and the
                    "Current role" flag already say it, twice over. */}
                <p class="role__when">{current.when}</p>
                <div>
                  <p class="role__flag">Current role</p>
                  <h3>
                    <b>{current.org}</b>
                    {current.where && <span> &middot; {current.where}</span>}
                  </h3>
                  <p class="stack">{stackLine(current)}</p>
                  {current.body && <p class="role__lede">{current.body}</p>}
                  {current.bullets && (
                    <ul class="role__pts">
                      {current.bullets.map((pt) => (
                        <li>{pt}</li>
                      ))}
                    </ul>
                  )}
                  {current.status && <p class="role__status">{current.status}</p>}
                </div>
              </article>
            )
          }

          <ol class="tl">
            {
              past.map((r) => (
                <li class="role" id={places[r.key].at} data-place data-stack={stackKey(r.stack)}>
                  <p class="role__when">{r.when}</p>
                  <div>
                    <h3>
                      <b>{r.org}</b>
                      {r.where && <span> &middot; {r.where}</span>}
                    </h3>
                    <p class="stack">{stackLine(r)}</p>
                    {r.body && (
                      <p>
                        {r.body}
                        {r.ref && (
                          <sup class="ref">
                            <a href={`#note-${r.ref}`}>[{r.ref}]</a>
                          </sup>
                        )}
                      </p>
                    )}
                  </div>
                </li>
              ))
            }
          </ol>
        </div>

        <dl class="errata">
          {
            errata.map((e) => (
              <div id={`note-${e.ref}`}>
                <dt>[{e.ref}]</dt>
                <dd>{e.text}</dd>
              </div>
            ))
          }
        </dl>

        <section class="edu" id="education" data-place data-reveal>
          <p class="kicker">Education &middot; {education.when}</p>
          <h3>{education.school}</h3>
          <p class="edu__note">{education.note}</p>

          <dl class="edu__deg">
            {
              education.degrees.map((d) => (
                <div>
                  <dt>{d.h}</dt>
                  <dd>{d.p}</dd>
                </div>
              ))
            }
          </dl>

          <ul class="courses">
            {
              courses.map((c) => (
                <li>
                  <b>{c.d}</b>
                  {c.t}
                  {/* Non-breaking, so a wrapped course never opens a line on
                      the separator. Same rule as the work log's stack row. */}
                  {c.i && <i>&#160;&middot; {c.i}</i>}
                </li>
              ))
            }
          </ul>

          <div class="method">
            <p class="kicker">Method</p>
            <p>{education.method}</p>
          </div>
        </section>
      </div>
    </div>
  </Section>

  {/* ── 04 Playground ─────────────────────────────────────────────────── */}
  <Section n="04" id="playground" name="Playground" tone="sand">
    <div class="head" data-reveal>
      <div class="head__k">
        <p class="kicker">04 / Playground</p>
        <p class="head__count">3 running inline</p>
      </div>
      <div>
        <h2 class="display head__t--long">{playground.statement}</h2>
        <p class="head__lead">{playground.prose[0]}</p>
      </div>
    </div>

    <div class="labs">
      <article class="lab" id={places.autotyper.at} data-place data-reveal>
        <div class="lab__head">
          <span class="lab__date">{playground.items[0]?.statusLabel}</span>
          <h3>
            {playground.items[0]?.name}<span class="era">{playground.items[0]?.yr}</span>
          </h3>
          <p>{playground.items[0]?.what}</p>
        </div>
        <AutoTyper client:visible />
      </article>

      <article class="lab" id={places.deviation.at} data-place data-reveal>
        <div class="lab__head">
          <span class="lab__date">{playground.items[1]?.statusLabel}</span>
          <h3>
            {playground.items[1]?.name}<span class="era">{playground.items[1]?.yr}</span>
          </h3>
          <p>{playground.items[1]?.what}</p>
        </div>
        <DeviationFrame
          client:visible
          src="/deviation.html?reps=1000&mean=-4&stdev=2&reps2=1000&mean2=6&stdev2=3"
          href="/deviation.html"
          title="deviation.html"
          note="The 2015 file itself, unmodified, seeded from its query string"
        />
      </article>

      {
        /* The two panels above are demos. This one is a game, it is the only
          thing on the page still wearing its own colours, and it is about to
          take the keyboard. All three are worth saying before it starts. */
      }
      <p class="play__break" data-reveal>
        <span>Original artifact</span>
        Its own 2015 colours, not this page's
      </p>

      <article class="lab lab--wide" id={places.grinch.at} data-place data-reveal>
        <div class="lab__head">
          <span class="lab__date">{playground.items[2]?.statusLabel}</span>
          <h3>
            {playground.items[2]?.name}<span class="era">{playground.items[2]?.yr}</span>
          </h3>
          <p>{playground.items[2]?.what}</p>
          <ul class="keys">
            <li><kbd>&larr;</kbd><kbd>&rarr;</kbd> Steer</li>
            <li class="keys--touch"><kbd>Tap</kbd> Steer</li>
            <li><kbd>P</kbd> Pause</li>
            <li><kbd>Esc</kbd> Exit</li>
            <li><kbd>Space</kbd> Restart</li>
          </ul>
          <p class="keys__note">
            The jump is not a control: landing on a platform is what throws him.
          </p>
        </div>
        <GameFrame
          client:visible
          src="/grinchjump.html"
          title="GrinchJump"
          poster={grinchPoster}
          posterAlt="GrinchJump running in a browser: a low-poly figure on a stack of green platforms against a pale sky, score counter in the corner."
          note="Vendored three.js r70, served from its original URL"
        />
      </article>
    </div>

    <div class="method">
      <p class="kicker">Method</p>
      <p>{playground.method}</p>
    </div>

    {
      /* An h3, like the three cards above it, because that is what it is a
        sibling of. The names inside were h4s, which made every one of them
        read as a subsection of GrinchJump. They are row labels, not sections,
        so they stop claiming to be headings. */
    }
    <h3 class="earlier__h" data-reveal>Also built, nothing left to run</h3>
    <ul class="earlier" data-reveal>
      {
        earlier.map((e) => (
          <li id={places[e.key].at} data-place>
            <span class="era">{e.yr}</span>
            <div>
              <p class="earlier__n">{e.name}</p>
              <p>{e.what}</p>
            </div>
            <span class="stack">{dots(e.k)}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* ── 05 Skills ─────────────────────────────────────────────────────── */}
  <Section n="05" id="skills" name="Skills" tone="ink-3">
    <div class="head" data-reveal>
      <div class="head__k">
        <p class="kicker">05 / Skills</p>
        <p class="head__count">{skillShown} of {skillTotal} turn up above</p>
      </div>
      <div>
        <h2 class="display head__t">Grouped, unrated</h2>
        <p class="head__lead">
          Not scored, because a skill bar you fill in yourself is a drawing. Pick one and the page
          shows you where it turns up, or admits that it doesn&#8217;t.
        </p>
      </div>
    </div>

    {
      /* An index, so it is built like one: pick an entry and it gives you the
        references. Radio buttons rather than script, because a radio group is
        already one-at-a-time, already arrow-navigable, already announced as a
        set, and still works on a page where nothing ran. The whole reveal is a
        single `:checked + label + p` rule.

        The references are element ids, not section ids, so a reference lands
        on the card that is the evidence. The card marks itself on arrival. */
    }
    <div class="skills" data-reveal>
      {
        skillIndex.map((g) => (
          <section class="skg">
            <h3>{g.group}</h3>
            <div class="skg__set">
              {g.items.map((i) => (
                <>
                  <input class="sk__r" type="radio" name="sk" id={i.id} />
                  <label class="sk" for={i.id}>
                    {i.name}
                  </label>
                  <p class="sk__ev">
                    {i.at.length ? (
                      <>
                        <span>Turns up in</span>
                        {i.at.map((pl) => (
                          <a href={`#${pl.at}`}>{pl.name}</a>
                        ))}
                      </>
                    ) : (
                      <span class="sk__ev--none">
                        On the r&#233;sum&#233;, nowhere on this page.
                      </span>
                    )}
                  </p>
                </>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </Section>

  {/* ── 06 Contact ────────────────────────────────────────────────────── */}
  <Section n="06" id="contact" name="Contact" tone="camel" cls="contact">
    <div class="contact__grid">
      <div data-reveal>
        <p class="kicker">06 / Contact</p>
        <h2 class="display">Write to me</h2>
        <p class="contact__copy">
          I read it and I answer it. If you want to talk about a sailing model, a voxel world, or
          why Python is the best language, that is the fastest way in.
        </p>
        <a class="contact__mail" href={`mailto:${contact.email}`}>{contact.email}</a>

        {
          /* A new tab rather than a forced download: a PDF opens in the reader
            every browser already ships, and saving it from there is one more
            click that the person who wants the file will happily make. */
        }
        <div class="resume">
          <a class="btn btn--sand" href={contact.resume} target="_blank" rel="noopener" data-resume>
            Résumé (PDF)
            <span class="btn__tag">{contact.resumeYear}</span>
          </a>
        </div>
      </div>

      <div class="links" data-reveal>
        <a href={contact.github} rel="me noopener"><span>GitHub</span><span>aj8uppal</span></a>
        <a href={contact.linkedin} rel="me noopener"><span>LinkedIn</span><span>aj-uppal</span></a>
        <a href={contact.stackoverflow} rel="me noopener">
          <span>Stack Overflow</span><span>A J Uppal</span>
        </a>
        <a href={`mailto:${contact.email}`}><span>Email</span><span>{contact.email}</span></a>
      </div>
    </div>

    <footer class="foot">
      <p>
        Astro and TypeScript, built static. Six React islands, all of them something you can move.
        Every screenshot is a capture of the actual project.
      </p>
      <p>
        The demos that predate this page are still served from their original URLs, because breaking
        a working link to tidy up a repository is not tidying up.
      </p>
      <p>
        Source at <a href={contact.github}>github.com/aj8uppal</a>.
      </p>
    </footer>
  </Section>
</Base>
