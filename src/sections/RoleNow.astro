---
/**
 * The current role, rendered on its own with the room the other seven do not
 * get. It keeps the .role class and the stack key, so the work-log filter
 * counts it as one of eight.
 *
 * It opens on the outcome and then gives the four points of ownership under
 * it. That summary used to live in a band of its own up by About, back when
 * the log sat below the projects and a reader met eight jobs late; the whole
 * section is second on the page now, so the band would be the same sentence
 * twice within a screen of itself. One telling, in the record.
 */
import Claim from '../components/Claim.astro';
import { callTrace, places } from '../data/content';
import { current, stackKey, stackLine } from '../lib/roles';
---

{
  current && (
    <article
      class="role role--now"
      id={places[current.key].at}
      data-place
      data-stack={stackKey(current.stack)}
    >
      {/* No dot after the date: the inked node on the spine and the
          "Current role" flag already say it, twice over. */}
      <p class="role__when">{current.when}</p>
      <div>
        <p class="role__flag">Current role</p>
        <h3>
          <b>{current.org}</b>
          {current.where && <span> &middot; {current.where}</span>}
        </h3>
        <p class="stack">{stackLine(current)}</p>
        {current.body && (
          <p class="role__lede">
            {current.ev ? <Claim of={current.ev}>{current.body}</Claim> : current.body}
          </p>
        )}
        {current.bullets && (
          <ul class="role__pts">
            {current.bullets.map((pt) => (
              <li>{pt}</li>
            ))}
          </ul>
        )}
        {current.status && (
          <p class="role__status">
            {current.statusEv ? (
              <Claim of={current.statusEv}>{current.status}</Claim>
            ) : (
              current.status
            )}
          </p>
        )}

        {/* Behind a press, like the projects' technical notes and for
            the same reason: the four points above are what a reader
            skimming this role needs, and ten more rows in front of
            them would bury the thing they came for. */}
        <details class="notes notes--paper trace">
          <summary>What one call looks like</summary>
          <p class="trace__frame">
            Not a recording. It is the shape of the thing: generic states, nobody's data, and the
            failure path left in, because that part is the job.
          </p>
          <ol class="trace__rows">
            {callTrace.map((s, i) => (
              <li class="trace__row">
                <span class="trace__n" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class:list={['trace__st', s.recovery && 'trace__st--rec']}>{s.state}</span>
                <span>{s.text}</span>
              </li>
            ))}
          </ol>
        </details>
      </div>
    </article>
  )
}
