---
import Claim from '../components/Claim.astro';
import Inspect from '../components/Inspect.astro';
import Section from '../components/Section.astro';
import type { Tone } from '../components/Section.astro';
import StackFilter from '../components/react/StackFilter';
import RoleNow from './RoleNow.astro';
import { courses, education, places, roles } from '../data/content';
import { filterTags, past, stackKey, stackLine } from '../lib/roles';

interface Props {
  /** Its number on this route. The two sides run the same sections in two orders. */
  n: string;
  tone: Tone;
  /**
   * Which end of the log to open at. Side A reads back from now, which is what
   * a hiring reader wants first. Side B reads forward from the first job, so
   * the current role is the thing you arrive at rather than the thing you start
   * from. Same eight roles, same markup, reversed.
   */
  order?: 'newest' | 'oldest';
}

const { n, tone, order = 'newest' } = Astro.props;
const newestFirst = order === 'newest';
const list = newestFirst ? past : [...past].reverse();
---

<Section n={n} id="work" name="Experience" tone={tone}>
  <div class="log">
    <div class="log__intro">
      <p class="kicker">{n} / Experience</p>
      <h2 class="display">Eight roles, one through-line</h2>
      <p>
        Physics research, university software, first-engineer jobs, and production healthcare AI.
        Most of my work has been building first versions of new systems.
      </p>
    </div>

    <div>
      {
        /* Idle, not visible. This is the first island on the page, so it is the
          one that pays for the React runtime: 182KB to fetch, parse and
          evaluate, and on a throttled machine that is a 26ms frame in the
          middle of a scroll. At idle it lands in the quiet after load, and
          every island below it then costs only its own two or three KB. */
      }
      <StackFilter client:idle tags={filterTags} total={roles.length} />
      <Inspect by="StackFilter.tsx" />

      <div class:list={['roles', !newestFirst && 'roles--fwd']}>
        {newestFirst && <RoleNow />}

        <ol class="tl">
          {
            list.map((r) => (
              <li class="role" id={places[r.key].at} data-place data-stack={stackKey(r.stack)}>
                <p class="role__when">{r.when}</p>
                <div>
                  <h3>
                    <b>{r.org}</b>
                    {r.where && <span> &middot; {r.where}</span>}
                  </h3>
                  <p class="stack">{stackLine(r)}</p>
                  {r.body && <p>{r.ev ? <Claim of={r.ev}>{r.body}</Claim> : r.body}</p>}
                </div>
              </li>
            ))
          }
        </ol>

        {!newestFirst && <RoleNow />}
      </div>

      <section class="edu" id="education" data-place data-reveal>
        <p class="kicker">Education &middot; {education.when}</p>
        <h3>{education.school}</h3>
        <p class="edu__note">{education.note}</p>

        <dl class="edu__deg">
          {
            education.degrees.map((d) => (
              <div>
                <dt>{d.h}</dt>
                <dd>{d.p}</dd>
              </div>
            ))
          }
        </dl>

        <ul class="courses">
          {
            courses.map((c) => (
              <li>
                <b>{c.d}</b>
                {c.t}
                {/* Non-breaking, so a wrapped course never opens a line on
                    the separator. Same rule as the work log's stack row. */}
                {c.i && <i>&#160;&middot; {c.i}</i>}
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</Section>
