---
/**
 * What the job is, before anything else asks to be looked at.
 *
 * The audit's third item: a reader met four side projects and eight jobs
 * before the page told them what he does for a living. This block answers
 * that one question and stops - the flag, the employer, and the sentence
 * that leads with the outcome rather than the story. The four points of
 * ownership, where the role stands today and the call trace are the full
 * record in the work log, and none of it is repeated here.
 *
 * A band of its own rather than a seventh section. The nav is six long and
 * this is a paragraph, not a chapter, so it carries no `data-sec`: the nav
 * marker and the chrome colour both read past it to the section it stands in
 * front of. It is not a `.role` either, which is why the work log's filter
 * leaves it alone - a summary is not a row.
 */
import Claim from '../components/Claim.astro';
import { places } from '../data/content';
import { current } from '../lib/roles';
import { dots } from '../lib/text';
---

{
  current && (
    <section class="sec sec--paper-2 now" id="now">
      <div class="shell">
        <div class="now__grid" data-reveal>
          <p class="now__flag">Current role</p>
          <div>
            <h2 class="now__h">
              <b>{current.org}</b>
              {current.where && <span> &middot; {current.where}</span>}
            </h2>
            <p class="now__stack">{dots(current.title, current.when)}</p>
            {current.body && (
              <p class="now__lede">
                {current.ev ? <Claim of={current.ev}>{current.body}</Claim> : current.body}
              </p>
            )}
            {/* Side-agnostic: the log is below this on Side A and above it on
                Side B, so the link names where it is going rather than which
                way. */}
            <a class="now__more" href={`#${places[current.key].at}`}>
              The full record, in the work log
            </a>
          </div>
        </div>
      </div>
    </section>
  )
}
