---
/**
 * One run of the three-column spine: index, sticky label, content.
 *
 * A section is made of one or more blocks. Full-bleed spreads sit between
 * blocks rather than inside them, which is why the spine can carry a break
 * without any negative-margin trickery.
 */
interface Props {
  n?: string;
  name?: string;
  gutter?: string[];
  tight?: boolean;
  /** The folded index line shown below 1024px, where the spine collapses. */
  hd?: boolean;
}

const { n, name, gutter, tight = false, hd = true } = Astro.props;
---

<div class="wrap">
  <div class:list={['sec__grid', { 'sec__grid--tight': tight }]}>
    <div class="sec__idx mono"><span>{n}</span></div>
    <div class="sec__label">
      {
        name && (
          <div>
            <p class="label">{name}</p>
            {gutter && (
              <p class="sec__gutter meta">
                {gutter.map((g) => (
                  <span>{g}</span>
                ))}
              </p>
            )}
          </div>
        )
      }
    </div>
    <div class="sec__main">
      {
        hd && n && name && (
          <div class="sec__hd">
            <span class="label n">{n}</span>
            <span class="label">{name}</span>
          </div>
        )
      }
      <slot />
    </div>
  </div>
</div>
