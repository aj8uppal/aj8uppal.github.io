---
/**
 * When a machine last opened this game and found it working.
 *
 * The state label above says LIVE, which is the author's claim. This says who
 * checked and when, which is the part a reader has no reason to take on
 * trust. Deliberately not a badge and deliberately not a dot: it is a dated
 * observation, and A5's rule is that a thing that looks like a label has to
 * be a label.
 *
 * It shows nothing when a run was blocked, because a runner that could not
 * reach a verdict has said nothing about the game and should not be allowed
 * to look like it has.
 */
import { on, receipt } from '../data/receipts';

interface Props {
  /** Matches the `key` on a target in scripts/receipts.mjs. */
  of: string;
}

const { of } = Astro.props;
const run = receipt(of);
const shown = !run || run.outcome !== 'blocked';
---

{
  shown && (
    <p class="receipt" data-receipt={run?.outcome ?? 'none'}>
      {run?.outcome === 'pass' ? (
        <>
          Last proved playable <time datetime={run.at}>{on(run.at)}</time>
        </>
      ) : run?.outcome === 'fail' ? (
        <>
          Did not come up on <time datetime={run.at}>{on(run.at)}</time>
        </>
      ) : (
        <>Not yet proved this build</>
      )}
    </p>
  )
}
