---
import { Picture } from 'astro:assets';
import { asset } from '../lib/images';
import { apps as originalApps, built, categories, type Built } from '../data/built';
interface Props {
  apps?: (Built & { image?: string; caseKey?: string })[];
  portfolio?: boolean;
}
const { portfolio = false } = Astro.props;
const apps: (Built & { image?: string; caseKey?: string })[] = Astro.props.apps || originalApps;
const selectedApps = apps.filter((app) => app.featured || app.selected);
const home = '/';
const W = [420, 640, 960, 1280];
const S = '(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 92vw';
---

<div class="bt" data-collection data-total={apps.length}>
  <section class="bt-top bt-shell" aria-labelledby="bt-title">
    <div class="bt-head">
      <h1 id="bt-title">Games, tools<br /><em>and instruments.</em></h1>
      <div class="bt-head__side">
        <p class="bt-lead">{built.lead}</p>
        <p class="bt-back">
          <a href={`${home}#${portfolio ? 'projects' : 'building'}`}
            >Selected projects <span aria-hidden="true">↗</span></a
          ><a href={portfolio ? '/portfolio/work/notable/' : `${home}#work`}
            >My engineering work <span aria-hidden="true">↗</span></a
          >
        </p>
      </div>
    </div>
    <div class="bt-intro-foot">
      <p>
        <strong>{apps.length}</strong> projects
      </p>
    </div>
  </section>

  <section class="bt-body bt-shell" aria-label="Explore the projects">
    <div class="bt-controls" hidden>
      <div
        class="bt-filter-scroll"
        tabindex="0"
        aria-label="Project filters; scroll horizontally for more"
      >
        <div class="bt-filters" role="group" aria-label="Filter projects">
          <button type="button" data-filter="selected" aria-pressed="true"
            >Start here <span>{selectedApps.length}</span></button
          >
          <button type="button" data-filter="all" aria-pressed="false"
            >All projects <span>{apps.length}</span></button
          >
          {
            categories.map((category) => (
              <button type="button" data-filter={category.key} aria-pressed="false">
                {category.label}
              </button>
            ))
          }
        </div>
      </div>
      <label class="bt-search"
        ><span>Find a project</span><input
          type="search"
          name="project"
          placeholder="Name, idea or technology"
          aria-controls="bt-gallery"
          autocomplete="off"
        /></label
      >
    </div>
    <div class="bt-results">
      <p class="bt-count" role="status" aria-live="polite" aria-atomic="true">
        {apps.length} projects to explore
      </p>
    </div>

    <div class="bt-gallery" id="bt-gallery">
      {
        apps.map((app, i) => (
          <article
            class="bcard"
            id={app.key}
            style={`--a:${app.accent}`}
            data-built-card
            data-selected={app.featured || app.selected || undefined}
            data-categories={app.categories.join(' ')}
            data-search={`${app.name} ${app.kind} ${app.what} ${app.how} ${app.k}`.toLowerCase()}
          >
            <a
              class="bcard__shot"
              href={app.caseKey ? `/portfolio/work/${app.caseKey}/` : app.href}
              tabindex="-1"
              aria-hidden="true"
            >
              <Picture
                src={asset(app.image || `built-${app.key}`)}
                alt=""
                widths={W}
                sizes={S}
                formats={['avif']}
                fallbackFormat="webp"
                loading={i < 3 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <span class="bcard__enter" aria-hidden="true">
                ↗
              </span>
            </a>
            <div class="bcard__body">
              <p class="bcard__meta">
                <>
                  <span class="bcard__kind">{app.kind}</span>
                  <span class={`bcard__state is-${app.reach}`}>{app.reachLabel}</span>
                </>
              </p>
              <h2 class="bcard__h">
                <a href={app.caseKey ? `/portfolio/work/${app.caseKey}/` : app.href}>{app.name}</a>
              </h2>
              <p class="bcard__what">{app.what}</p>
              <p class="bcard__how">{app.how}</p>
              {app.caseKey && (
                <a class="bcard__inside" href={`/portfolio/work/${app.caseKey}/`}>
                  Inside the build <span aria-hidden="true">→</span>
                </a>
              )}
              <div class="bcard__foot">
                <p class="bcard__k">{app.k}</p>
                <p class="bcard__go">
                  <a href={app.href}>
                    {app.cta}
                    <span aria-hidden="true">↗</span>
                  </a>
                </p>
              </div>
              <details class="bcard__capture">
                <>
                  <summary>In this frame</summary>
                  <p>{app.cap}</p>
                  {app.alt !== app.cap && <p class="sr">{app.alt}</p>}
                </>
              </details>
            </div>
          </article>
        ))
      }
    </div>
    <div class="bt-empty" hidden>
      <h2>No matching projects.</h2><p>Try another search or browse all projects.</p><button
        type="button"
        data-reset>Show all projects <span aria-hidden="true">↗</span></button
      >
    </div>
    <div class="bt-more" hidden>
      <button type="button" data-more>Show more projects <span aria-hidden="true">↓</span></button
      ><p data-remaining></p>
    </div>
    <noscript
      ><p class="bt-noscript">
        The whole collection is shown here. Every project opens without the gallery controls.
      </p></noscript
    >
  </section>

  <p class="bt-caveat bt-shell">{built.caveat}</p>
  <section class="bt-foot bt-shell">
    <div>
      <p class="bt-eyebrow">Get in touch</p><h2>
        Have a project<br /><em>in mind?</em>
      </h2>
    </div>
    <div>
      <p>I’m a software engineer at Notable Health in the Bay Area.</p><p class="bt-foot__go">
        <a href={home}>Meet the engineer <span aria-hidden="true">↗</span></a><a
          href={`mailto:aj8uppal@gmail.com`}>Get in touch <span aria-hidden="true">↗</span></a
        >
      </p>
    </div>
  </section>
</div>
<script>
  const root = document.querySelector<HTMLElement>('[data-collection]');
  if (root) {
    const gallery = root.querySelector<HTMLElement>('.bt-gallery')!;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-built-card]')];
    const filters = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const search = root.querySelector<HTMLInputElement>('input[type="search"]')!;
    const status = root.querySelector<HTMLElement>('.bt-count')!;
    const more = root.querySelector<HTMLElement>('.bt-more')!;
    const moreButton = more.querySelector<HTMLButtonElement>('button')!;
    const empty = root.querySelector<HTMLElement>('.bt-empty')!;
    const pageSize = 6;
    let active = 'selected';
    let limit = pageSize;

    function update(writeURL = false) {
      const query = search.value.trim().toLowerCase();
      const terms = query.split(/\s+/).filter(Boolean);
      const matches = cards.filter((card) => {
        const inCategory =
          active === 'all' ||
          (active === 'selected'
            ? card.hasAttribute('data-selected')
            : card.dataset.categories?.split(' ').includes(active));
        return inCategory && terms.every((term) => card.dataset.search?.includes(term));
      });
      const visible = matches.slice(0, limit);
      for (const card of cards) card.hidden = !visible.includes(card);
      for (const button of filters)
        button.setAttribute('aria-pressed', String(button.dataset.filter === active));
      gallery.dataset.ready = '';
      status.textContent = matches.length
        ? `${visible.length} of ${matches.length} projects${active === 'selected' ? ' · a few good starting points' : ''}`
        : 'No matching projects';
      empty.hidden = matches.length > 0;
      const remaining = matches.length - visible.length;
      more.hidden = remaining === 0;
      moreButton.textContent = `Show ${Math.min(pageSize, remaining)} more ↓`;
      more.querySelector<HTMLElement>('[data-remaining]')!.textContent =
        `${remaining} more to discover`;
      if (writeURL) {
        const url = new URL(location.href);
        if (active === 'selected') url.searchParams.delete('filter');
        else url.searchParams.set('filter', active);
        if (query) url.searchParams.set('q', search.value.trim());
        else url.searchParams.delete('q');
        url.hash = '';
        history.replaceState(null, '', url);
      }
      return visible;
    }

    function readURL() {
      const url = new URL(location.href);
      const requested = url.searchParams.get('filter') || 'selected';
      active = filters.some((button) => button.dataset.filter === requested)
        ? requested
        : 'selected';
      search.value = url.searchParams.get('q') || '';
      if (search.value && active === 'selected') active = 'all';
      limit = pageSize;
      let target: HTMLElement | undefined;
      try {
        target = cards.find((card) => card.id === decodeURIComponent(url.hash.slice(1)));
      } catch {
        /* An invalid fragment leaves the selection alone. */
      }
      if (target) {
        active = 'all';
        search.value = '';
        limit = Math.ceil((cards.indexOf(target) + 1) / pageSize) * pageSize;
      }
      update();
      if (target) requestAnimationFrame(() => target?.scrollIntoView({ block: 'start' }));
    }

    filters.forEach((button) =>
      button.addEventListener('click', () => {
        active = button.dataset.filter!;
        limit = pageSize;
        update(true);
      }),
    );
    search.addEventListener('input', () => {
      if (active === 'selected' && search.value.trim()) active = 'all';
      limit = pageSize;
      update(true);
    });
    moreButton.addEventListener('click', () => {
      const previous = limit;
      limit += pageSize;
      const visible = update();
      visible[previous]?.querySelector<HTMLAnchorElement>('.bcard__h a')?.focus();
    });
    root.querySelector<HTMLButtonElement>('[data-reset]')!.addEventListener('click', () => {
      active = 'all';
      search.value = '';
      limit = pageSize;
      update(true);
      filters.find((button) => button.dataset.filter === 'all')?.focus();
    });
    window.addEventListener('popstate', readURL);
    window.addEventListener('hashchange', readURL);
    readURL();
    root.querySelector<HTMLElement>('.bt-controls')!.hidden = false;
    const filterScroll = root.querySelector<HTMLElement>('.bt-filter-scroll')!;
    const showScrollEdges = () => {
      const overflow = filterScroll.scrollWidth > filterScroll.clientWidth + 2;
      filterScroll.dataset.overflow = String(overflow);
      filterScroll.dataset.atEnd = String(
        overflow &&
          filterScroll.scrollLeft + filterScroll.clientWidth >= filterScroll.scrollWidth - 2,
      );
    };
    filterScroll.addEventListener('scroll', showScrollEdges, { passive: true });
    new ResizeObserver(showScrollEdges).observe(filterScroll);
    showScrollEdges();
  }
</script>

<style>
  .bcard__inside {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 13px;
    gap: 10px;
    color: var(--a);
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .bt {
    --bt-ink: #edf0e6;
    --bt-muted: #b1c5c1;
    --bt-ground: #0d1e25;
    --bt-card: #132a32;
    --bt-hover: #203b43;
    --bt-line: #455d62;
    color: var(--bt-ink);
    background: var(--bt-ground);
  }
  .bt [hidden] {
    display: none !important;
  }
  .bt-shell {
    width: min(1280px, calc(100% - 96px));
    margin-inline: auto;
  }
  .bt-top {
    padding-block: 96px 20px;
  }
  .bt-eyebrow {
    margin: 0 0 24px;
    font: 11px/1.5 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--bt-muted);
  }
  .bt-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 48px;
  }
  .bt-head h1 {
    margin: 0;
    font:
      400 clamp(56px, 7.2vw, 100px)/0.98 Georgia,
      serif;
    letter-spacing: -0.055em;
    text-transform: none;
  }
  .bt-head h1 em,
  .bt-foot h2 em {
    color: #bad7c5;
    font-weight: 400;
  }
  .bt-head__side {
    max-width: 49ch;
    padding-bottom: 4px;
  }
  .bt-lead {
    margin: 0 0 16px;
    font-size: clamp(17px, 1.45vw, 20px);
    line-height: 1.55;
  }
  .bt-back {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin: 16px 0 0;
    font-size: 13px;
  }
  .bt-back a,
  .bt-foot__go a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    text-decoration: none;
    border-bottom: 1px solid var(--bt-line);
  }
  .bt-back a:hover,
  .bt-foot__go a:hover {
    border-color: #bad7c5;
  }
  .bt-intro-foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 32px;
    padding: 26px 0 0;
    margin-top: 40px;
    border-top: 1px solid var(--bt-line);
    color: var(--bt-muted);
  }
  .bt-intro-foot p {
    margin: 0;
    font-size: 12px;
    line-height: 1.7;
  }
  .bt-intro-foot strong {
    font-size: 16px;
    color: var(--bt-ink);
    font-weight: 500;
  }
  .bt-intro-foot span {
    padding-inline: 8px;
  }
  .bt-caveat {
    color: var(--bt-muted);
    padding-bottom: 32px;
    font-size: 12px;
    line-height: 1.7;
  }
  .bt-body {
    padding-bottom: 64px;
  }
  .bt-controls {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-block: 20px;
    border-bottom: 1px solid var(--bt-line);
  }
  .bt-filter-scroll {
    min-width: 0;
    overflow-x: auto;
    padding-block: 4px;
    scrollbar-width: thin;
    scrollbar-color: var(--bt-line) transparent;
  }
  .bt-filter-scroll[data-overflow='true'] {
    mask-image: linear-gradient(to right, #000 0%, #000 calc(100% - 40px), transparent);
  }
  .bt-filter-scroll[data-at-end='true'] {
    mask-image: linear-gradient(to right, transparent, #000 28px, #000);
  }
  .bt-filters {
    display: flex;
    align-items: center;
    width: max-content;
    gap: 6px;
  }
  .bt-filters button {
    min-height: 44px;
    border: 1px solid transparent;
    border-radius: 4px;
    background: transparent;
    padding: 10px 14px;
    color: var(--bt-muted);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .bt-filters button span {
    margin-left: 5px;
    font-size: 10px;
    opacity: 0.8;
  }
  .bt-filters button:hover {
    border-color: var(--bt-line);
    color: var(--bt-ink);
  }
  .bt-filters button[aria-pressed='true'] {
    color: #0d1e25;
    background: #bad7c5;
  }
  .bt-search {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 12px;
    color: var(--bt-muted);
  }
  .bt-search input {
    width: min(360px, 100%);
    min-width: 0;
    min-height: 44px;
    border: 1px solid var(--bt-line);
    border-radius: 4px;
    background: var(--bt-card);
    color: var(--bt-ink);
    padding: 10px 14px;
    font: inherit;
    font-size: 14px;
  }
  .bt-search input::placeholder {
    color: var(--bt-muted);
    opacity: 1;
  }
  .bt-results {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    font: 11px/1.5 var(--mono);
    color: var(--bt-muted);
  }
  .bt-count {
    margin: 0;
  }
  .bt-gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 24px;
    align-items: start;
  }
  :global(.js) .bt-gallery:not([data-ready]) .bcard:not([data-selected]) {
    display: none;
  }
  .bcard {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--bt-line);
    background: var(--bt-card);
    border-radius: 5px;
    scroll-margin-top: 100px;
    transition:
      background 180ms,
      border-color 180ms;
  }
  .bcard:hover,
  .bcard:focus-within {
    background: var(--bt-hover);
    border-color: var(--a);
  }
  .bcard__shot {
    display: block;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--bt-line);
    background: #09171d;
  }
  .bcard__shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: center;
    transition: transform 350ms ease;
  }
  .bcard:hover .bcard__shot img {
    transform: scale(1.025);
  }
  .bcard__enter {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid #9eafaa;
    border-radius: 50%;
    background: #0d1e25e8;
    color: #edf0e6;
  }
  .bcard__body {
    padding: 20px 20px 12px;
  }
  .bcard__meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 12px;
    font: 10px/1.5 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .bcard__kind {
    color: var(--a);
  }
  .bcard__state {
    color: var(--bt-muted);
  }
  .bcard__h {
    margin: 0 0 10px;
    font:
      400 clamp(24px, 2.2vw, 30px)/1.14 Georgia,
      serif;
    letter-spacing: -0.025em;
    text-transform: none;
  }
  .bcard__h a {
    text-decoration: none;
    display: inline-block;
    padding-block: 4px;
  }
  .bcard__h a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .bcard__what {
    min-height: 3.1em;
    margin: 0 0 15px;
    font-size: 15px;
    line-height: 1.55;
  }
  .bcard__how {
    min-height: 6.3em;
    margin: 0 0 20px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--bt-muted);
  }
  .bcard__foot {
    border-top: 1px solid var(--bt-line);
    padding-top: 12px;
  }
  .bcard__k {
    min-height: 2.9em;
    margin: 0;
    color: var(--bt-muted);
    font: 10px/1.5 var(--mono);
  }
  .bcard__go {
    margin: 8px 0 0;
  }
  .bcard__go a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    font-weight: 600;
    color: var(--a);
    text-decoration: none;
  }
  .bcard__go a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .bcard__capture {
    border-top: 1px solid var(--bt-line);
    color: var(--bt-muted);
  }
  .bcard__capture summary {
    cursor: pointer;
    width: fit-content;
    min-height: 44px;
    padding-block: 14px;
    font-size: 10px;
    line-height: 1.6;
  }
  .bcard__capture p {
    font-size: 12px;
    line-height: 1.55;
    margin: 0 0 12px;
  }
  .bt-empty {
    padding: 72px 0;
    text-align: center;
  }
  .bt-empty h2 {
    font:
      32px/1.2 Georgia,
      serif;
    text-transform: none;
  }
  .bt-empty p {
    color: var(--bt-muted);
  }
  .bt-empty button,
  .bt-more button {
    min-height: 48px;
    border: 1px solid #bad7c5;
    border-radius: 4px;
    background: #bad7c5;
    color: #0d1e25;
    padding: 12px 24px;
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }
  .bt-more {
    margin-top: 40px;
    text-align: center;
  }
  .bt-more p,
  .bt-noscript {
    margin: 12px 0 0;
    font-size: 12px;
    color: var(--bt-muted);
  }
  .bt-foot {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    padding-block: 64px 80px;
    border-top: 1px solid var(--bt-line);
  }
  .bt-foot h2 {
    margin: 0;
    font:
      400 clamp(32px, 4.2vw, 56px)/1.1 Georgia,
      serif;
    text-transform: none;
    letter-spacing: -0.04em;
  }
  .bt-foot > div + div {
    align-self: end;
    max-width: 46ch;
    font-size: 16px;
    line-height: 1.65;
    color: var(--bt-muted);
  }
  .bt-foot__go {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin: 20px 0 0;
    font-size: 14px;
    color: var(--bt-ink);
  }
  .bt :is(a, button, input, summary):focus-visible {
    outline: 2px solid #edf0e6;
    outline-offset: 4px;
  }
  @media (max-width: 1100px) {
    .bt-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .bt-shell {
      width: calc(100% - 40px);
    }
    .bt-top {
      padding-block: 80px 8px;
    }
    .bt-head,
    .bt-foot {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .bt-head h1 {
      font-size: clamp(56px, 13vw, 80px);
    }
    .bt-intro-foot {
      flex-direction: column;
      gap: 12px;
      margin-top: 16px;
      padding-top: 12px;
    }
    .bt-controls {
      padding-block: 12px;
      gap: 12px;
    }
    .bt-results {
      padding-block: 12px;
    }
    .bt-search {
      align-items: stretch;
      flex-direction: column;
      gap: 8px;
    }
    .bt-search input {
      width: 100%;
    }
    .bt-gallery {
      grid-template-columns: minmax(0, 1fr);
    }
    .bcard__body {
      padding-inline: 20px;
    }
    .bcard__what,
    .bcard__how,
    .bcard__k {
      min-height: 0;
    }
    .bt-results-note {
      display: none;
    }
    .bt-foot {
      padding-block: 40px 56px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bt *,
    .bt *::before,
    .bt *::after {
      transition: none !important;
      scroll-behavior: auto !important;
    }
    .bcard:hover .bcard__shot img {
