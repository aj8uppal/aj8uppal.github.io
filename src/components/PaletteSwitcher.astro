---
/**
 * The palette switcher. A review tool, not part of the site.
 *
 * It is rendered only on a dev build, or on one made with `npm run
 * build:palettes`, and on the second of those it stays out of the way until
 * the URL asks for it with `?palettes`. A default production build does not
 * contain this markup, this script, or these styles at all: the gate is in
 * Base.astro, so nothing here is ever reached.
 *
 * Everything it can change is a custom property on `:root`, so it never has to
 * know what the page is made of. Canvases cannot inherit a custom property, so
 * the two that paint their own colours listen for `palettechange`.
 */
import { palettes, swatch, defaultPalette } from '../data/palettes';

interface Props {
  /** Dev builds show it unasked. A flagged production build waits for ?palettes. */
  alwaysOn: boolean;
}

const { alwaysOn } = Astro.props;
---

<aside
  class="pal"
  data-palette-switcher
  data-always={alwaysOn ? 'on' : 'off'}
  data-default={defaultPalette.id}
  hidden
  aria-label="Palette review switcher"
>
  <p class="pal__t">Palette · review only</p>
  <div class="pal__row">
    {
      palettes.map((p) => (
        <button
          class="pal__b"
          type="button"
          data-pal={p.id}
          aria-pressed={p.id === defaultPalette.id}
          title={`${p.id} · ${p.name} · ${p.by}${p.scheme === 'light' ? ' · light' : ''}`}
        >
          <span class="pal__sw" aria-hidden="true">
            {swatch(p).map((c) => (
              <i style={`background:${c}`} />
            ))}
          </span>
          <span class="pal__id" aria-hidden="true">
            {p.id}
          </span>
          <span class="sr">
            {p.name}, {p.by}
          </span>
        </button>
      ))
    }
  </div>
</aside>

<script>
  import { palettes, defaultPalette } from '../data/palettes';

  const KEY = 'p6-palette';
  const box = document.querySelector<HTMLElement>('[data-palette-switcher]');

  if (
    box &&
    (box.dataset.always === 'on' || new URLSearchParams(location.search).has('palettes'))
  ) {
    box.hidden = false;

    const root = document.documentElement;
    /* Every property any palette can set, so switching away from one clears
       what it wrote rather than leaving it under the next. */
    const owned = new Set(palettes.flatMap((p) => Object.keys(p.vars)));

    const apply = (id: string): void => {
      const p = palettes.find((x) => x.id === id) ?? defaultPalette;
      for (const name of owned) root.style.removeProperty(name);
      for (const [name, value] of Object.entries(p.vars)) root.style.setProperty(name, value);
      if (p.isDefault) root.style.removeProperty('color-scheme');
      else root.style.setProperty('color-scheme', p.scheme);

      for (const b of box.querySelectorAll<HTMLButtonElement>('[data-pal]')) {
        b.setAttribute('aria-pressed', String(b.dataset.pal === p.id));
      }
      window.dispatchEvent(new Event('palettechange'));
    };

    box.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-pal]');
      if (!b?.dataset.pal) return;
      localStorage.setItem(KEY, b.dataset.pal);
      apply(b.dataset.pal);
    });

    const stored = localStorage.getItem(KEY);
    if (stored && stored !== box.dataset.default) apply(stored);
  }
</script>

<style>
  .pal {
    position: fixed;
    z-index: 90;
    right: 0.8rem;
    bottom: 0.8rem;
    max-width: min(320px, calc(100vw - 1.6rem));
    padding: 0.6rem 0.7rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--on-shade) 22%, transparent);
    border-radius: 14px;
    color: var(--on-shade);
    background: color-mix(in srgb, var(--shade) 88%, transparent);
    box-shadow: 0 14px 45px rgb(0 0 0 / 30%);
    backdrop-filter: blur(18px) saturate(125%);
  }

  .pal[hidden] {
    display: none;
  }

  .pal__t {
    margin: 0 0 0.5rem;
    color: var(--on-shade-2);
    font: 800 0.6rem/1 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pal__row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.4rem;
  }

  .pal__b {
    min-height: 44px;
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.3rem;
    border: 1px solid color-mix(in srgb, var(--on-shade) 20%, transparent);
    border-radius: 9px;
    color: inherit;
    background: transparent;
    cursor: pointer;
  }

  .pal__b:hover {
    border-color: color-mix(in srgb, var(--on-shade) 55%, transparent);
  }

  .pal__b[aria-pressed='true'] {
    border-color: var(--on-shade);
    background: color-mix(in srgb, var(--on-shade) 14%, transparent);
  }

  /* Four bars rather than one swatch: the pair of grounds and the pair of
     accents are the four decisions a palette actually makes. */
  .pal__sw {
    display: flex;
    width: 100%;
    height: 12px;
    overflow: hidden;
    border-radius: 3px;
  }

  .pal__sw i {
    flex: 1;
  }

  .pal__id {
    font: 800 0.62rem/1 var(--mono);
  }
</style>
