---
/**
 * The shell for the redesigned site: one dark look, four self-hosted families,
 * and the shared tokens in orbit.css. Pages pass their own title, description
 * and social image; the homepage adds the WebGL scene on top.
 */
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMonoLatin from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import '../orbit/orbit.css';
import { getImage } from 'astro:assets';
import { asset } from '../lib/images';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonicalPath?: string;
  index?: boolean;
  bodyClass?: string;
}
const {
  title = 'AJ Uppal — Software engineer, builder of worlds',
  description = 'AJ Uppal is a software engineer at Notable Health who builds worlds that run in a browser tab: a sailing MMO, a voxel MMORPG, a WebGPU music visualizer, rollback-netcode fighters and more.',
  image = 'orbit-social',
  imageAlt = 'A black hole with a glowing accretion disk, rendered live on AJ Uppal’s homepage.',
  canonicalPath = Astro.url.pathname,
  index = true,
  bodyClass = '',
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
const social = await getImage({
  src: asset(image),
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={index ? 'index, follow' : 'noindex, follow'} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#020207" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(social.src, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(social.src, Astro.site)} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
